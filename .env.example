APP_NAME="IPTV Middleware"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP:25460

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iptv_middleware
DB_USERNAME=iptv
DB_PASSWORD=change_me

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@iptv.local"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=
JWT_TTL=1440

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@iptv-middleware.com

STREAM_SERVER_IP=
STREAM_SERVER_PORT=25460
STREAM_DEFAULT_PASSWORD=12345
STREAM_AUTO_DISCONNECT=120

TMDB_API_KEY=
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_IMAGE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=en-US
TMDB_REGION=US
TMDB_CACHE_TTL=86400

OFFLINE_VIDEO_PATH=/opt/iptv-middleware/storage/app/offline/channel-offline.mp4

# ── Standalone Streaming (XC-VM-style architecture) ──────────────────────────
# No external streaming engine required. The middleware handles all streaming
# directly using background FFmpeg processes + Nginx.
#
# HLS tuning — lower values = faster channel zapping (ultra-low-latency)
XC_VM_HLS_SEGMENT_DURATION=2
XC_VM_HLS_PLAYLIST_SIZE=3
XC_VM_HLS_KEYFRAME_INTERVAL=100

# Max age (seconds) of a playlist before the watchdog considers ingest dead
XC_VM_MAX_PLAYLIST_AGE=120
