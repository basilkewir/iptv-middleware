[Unit]
Description=IPTV Middleware - Start all ingest on boot
After=network-online.target mysql.service redis-server.service nginx.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=__APP_DIR__
ExecStart=/usr/bin/php __APP_DIR__/artisan ingest:ensure-all
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
