[Unit]
Description=XC-VM Streaming Engine (loopback-only)
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/xcvm
# XC-VM ships its own start script; fall back to php built-in server if absent
ExecStart=/bin/bash -c '\
  if [ -f /opt/xcvm/start.sh ]; then \
    exec bash /opt/xcvm/start.sh; \
  else \
    exec php -S 127.0.0.1:${XCVM_PORT:-25462} -t /opt/xcvm/www /opt/xcvm/www/index.php; \
  fi'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# Never expose XC-VM to the network — loopback only
Environment=XCVM_BIND=127.0.0.1

[Install]
WantedBy=multi-user.target
